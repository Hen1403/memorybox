---
import Base from '../layouts/Base.astro';
---
<Base titel="Datenschutz | memorybox" beschreibung="Datenschutzerklärung der memorybox Fotobox.">
  <section class="abschnitt">
    <div class="container text">
      <h1>Datenschutzerklärung</h1>
      <p class="hinweis">[Platzhalter: Die Datenschutzerklärung wird vor dem Livegang mit einem Generator (z. B. eRecht24 oder Dr. Schwenke) erstellt – passend zu Hosting-Anbieter, Anfrageformular und cookielosen Statistiken.]</p>
      <h2>Was diese Seite bewusst nicht tut</h2>
      <ul>
        <li>Keine Cookies, kein Tracking über Drittanbieter.</li>
        <li>Schriften werden vom eigenen Server geladen, nicht von Google.</li>
        <li>Instagram und WhatsApp sind nur verlinkt, nicht eingebettet.</li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .text { max-width: 720px; }
  .text h1 { font-size: clamp(2.2rem, 5vw, 3rem); }
  .text h2 { font-size: 1.3rem; margin-top: 2em; }
  .hinweis { background: var(--honig-hell); color: var(--walnuss); padding: 12px 16px; border-radius: 8px; }
</style>
