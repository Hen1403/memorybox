---
import { p } from '../lib/pfad';
import site from '../data/site.json';
---
<nav class="mobilbar" aria-label="Schnellkontakt">
  <a href={p('/anfrage/')} class="button mobilbar__cta">Termin anfragen</a>
  <a href={`https://wa.me/${site.whatsapp}`} class="mobilbar__icon" aria-label="WhatsApp" rel="noopener" target="_blank">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21" /></svg>
  </a>
  <a href={`tel:${site.telefon.replace(/\s/g, '')}`} class="mobilbar__icon" aria-label="Anrufen">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
  </a>
</nav>

<style>
  .mobilbar { display: none; }
  @media (max-width: 760px) {
    .mobilbar {
      display: flex;
      gap: 10px;
      position: fixed;
      inset: auto 0 0 0;
      z-index: 60;
      padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
      background: var(--papier);
      box-shadow: 0 -6px 18px -12px rgba(28, 23, 20, 0.35);
    }
    .mobilbar__cta { flex: 1; }
    .mobilbar__icon {
      width: 50px; height: 50px; flex: none;
      display: grid; place-items: center;
      border: 1.5px solid var(--walnuss); border-radius: 50%;
      color: var(--walnuss);
      transition: transform 120ms var(--ease-out);
    }
    .mobilbar__icon:active { transform: scale(0.94); }
  }
</style>
